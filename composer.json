{
    "name": "idle-user/api",
    "description": "An API for idleuser.com built with Slim Framework",
    "keywords": [
        "microframework",
        "rest",
        "router",
        "psr7",
        "api"
    ],
    "homepage": "https://github.com/idle-user/api.idleuser.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Jesus Andrade",
            "homepage": "https://idleuser.com/"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "middlewares/trailing-slash": "^2.1",
        "monolog/monolog": "^2.9",
        "php-di/php-di": "^6.4",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8080 -t public",
        "test": "phpunit"
    }
}
